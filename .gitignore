# Generated course payloads.
#
# Everything under build/ is derived from lessons/ and is regenerated by
# build/build_course_json.py. It is ~5.5 MB of JSON that changes on every
# rebuild, so it stays out of git — the lessons are the source of truth.
#
#   python build/build_course_json.py            # validate + write
#   python build/build_course_json.py --check     # validate only
build/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs and scratch
*.log
*.tmp
tmp/
scratch/
